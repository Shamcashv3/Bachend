# انسخ هذا الملف إلى .env وعدّل القيم

# كلمة مرور لوحة الإدارة (غيّرها إلى شيء قوي)
ADMIN_PASSWORD=change_this_password

# النطاق المسموح له بالاتصال بالـ backend (رابط موقعك على GitHub Pages)
ALLOWED_ORIGIN=https://your-username.github.io

# المنفذ (اختياري، بعض خدمات الاستضافة تحدده تلقائيًا)
PORT=3000

# توكن مجاني من ipinfo.io لتحديد موقع الزائر بدقة أعلى من geoip المجانية
# احصل عليه من: https://ipinfo.io/signup (الخطة المجانية: 50,000 طلب/شهر)
IPINFO_TOKEN=
